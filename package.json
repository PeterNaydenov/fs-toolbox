{
  "name": "fs-toolbox",
  "version": "3.1.13",
  "description": "File System Toolbox",
  "main": "src/fs-toolbox.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/fs-toolbox.js",
      "require": "./dist/fsbox.cjs",
      "default": "./src/fs-toolbox.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "dependencies": {
    "ask-for-promise": "^3.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.1",
    "rollup": "^4.63.2",
    "vitest": "^5.0.1"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/fs-toolbox.git"
  },
  "keywords": [
    "fs",
    "file",
    "folder",
    "toolbox"
  ],
  "author": "Peter Naydenov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PeterNaydenov/fs-toolbox/issues"
  },
  "homepage": "https://github.com/PeterNaydenov/fs-toolbox#readme",
  "vitest": {
    "coverage": {
      "provider": "v8",
      "include": [
        "src/**/*.js"
      ],
      "exclude": [
        "node_modules",
        "test",
        "test-data"
      ],
      "reporter": [
        "lcov",
        "text-summary"
      ]
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
